generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
}

enum HttpMethod {
  GET
  POST
  HEAD
}
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  monitors     Monitor[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
model Monitor {
  id              String        @id @default(uuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  url             String
  method          HttpMethod    @default(GET)
  intervalSeconds Int           @default(60)
  enabled         Boolean       @default(true)
  status          MonitorStatus @default(PENDING)
  checks MonitorCheck[]
  alerts MonitorAlert[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model MonitorCheck {
  id             String   @id @default(uuid())
  monitorId      String
  status         String
  httpStatusCode Int?
  responseTimeMs Int?
  checkedAt      DateTime @default(now())
  failureReason  String?
  monitor        Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  // Database-কে বলছে monitorId এবং checkedAt এই দুটি column-এর ওপর একসঙ্গে index তৈরি করতে।
}

enum MonitorAlertType {
  DOWN
  RECOVERED
}

model MonitorAlert {
  id        String            @id @default(uuid())
  monitorId String
  type      MonitorAlertType
  message   String
  isRead    Boolean           @default(false)
  readAt    DateTime?
  createdAt DateTime          @default(now())
  monitor   Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt])
  @@index([type, createdAt])
  @@index([isRead, createdAt])
}
